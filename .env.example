# Free key from https://openalex.org/settings/api (required since Feb 2026; $1/day free usage)
OPENALEX_API_KEY=

# Request at https://www.semanticscholar.org/product/api (arrives by email; works without it at a shared, slower limit)
SEMANTIC_SCHOLAR_API_KEY=

# Contact email sent to Crossref and OpenAlex (polite use). Use the project's email, not a student's.
CONTACT_EMAIL=

# Optional. If set, every request must include ?key=THIS_VALUE in the URL.
# Add the same ?key=... to the connector URL you give Claude or the GPT.
CONNECTOR_KEY=
